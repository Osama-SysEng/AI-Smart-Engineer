# --- App ---
APP_NAME=AI Smart Engineer
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-to-32-plus-characters-long-secret

# --- Database / Redis ---
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/db
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=engineer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engineer

# --- Auth ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI providers (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
LOCAL_LLM_URL=http://localhost:11434

# --- SAP (read-only/dry-run by default) ---
SAP_HOST=
SAP_PORT=8000
SAP_USER=
SAP_PASSWORD=
SAP_READ_ONLY=true
SAP_DRY_RUN=true

# --- Storage ---
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
MAX_FILE_SIZE_MB=100
MAX_REQUEST_BODY_MB=10

# --- Database pooling / TLS ---
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=prefer
DATABASE_APPLICATION_NAME=ai-smart-engineer-api

# --- Auth / JWT hardening ---
JWT_ISSUER=ai-smart-engineer
JWT_AUDIENCE=ai-smart-engineer-api
REQUIRE_SESSION_BOUND_TOKENS=true
MFA_ENABLED=true

# --- AI routing / cost control ---
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o
FALLBACK_PROVIDER=deepseek
LOCAL_MODEL_ENABLED=true
AI_COST_LIMIT_DAILY=100
AI_COST_LIMIT_MONTHLY=2000

# --- SAP extra ---
SAP_CLIENT=100
SAP_ASHOST=
SAP_SYSNR=00
SAP_MOCK_MODE=false

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Monitoring ---
SENTRY_DSN=

# --- Feature flags ---
ENABLE_AI_CHAT=true
ENABLE_SAP_SYNC=true
ENABLE_WORKFLOW_AUTOMATION=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_REAL_TIME_UPDATES=true

# --- Multi-tenant ---
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT=default

# --- Confidence thresholds ---
CONFIDENCE_AUTO_ACCEPT=0.95
CONFIDENCE_REVIEW=0.80

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
